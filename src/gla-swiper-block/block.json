{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gla/swiper-block",
	"version": "1.0.0",
	"title": "Swiper Slider",
	"category": "media",
	"icon": "images-alt2",
	"description": "A responsive slider with swipe support and configurable effects.",
	"keywords": [ "slider", "carousel", "swiper", "slideshow" ],
	"textdomain": "gla-swiper-block",
	"attributes": {
		"effect": { "type": "string", "default": "slide" },
		"speed": { "type": "number", "default": 600 },
		"loop": { "type": "boolean", "default": false },
		"direction": { "type": "string", "default": "horizontal" },
		"autoHeight": { "type": "boolean", "default": false },
		"label": { "type": "string", "default": "" },
		"slidesMobile": { "type": "number", "default": 1 },
		"slidesTablet": { "type": "number", "default": 1 },
		"slidesDesktop": { "type": "number", "default": 1 },
		"gapMobile": { "type": "number", "default": 16 },
		"gapTablet": { "type": "number", "default": 16 },
		"gapDesktop": { "type": "number", "default": 24 },
		"minHeight": { "type": "string", "default": "" },
		"aspectRatio": { "type": "string", "default": "" },
		"autoplay": { "type": "boolean", "default": false },
		"autoplayDelay": { "type": "number", "default": 4000 },
		"pauseOnHover": { "type": "boolean", "default": true },
		"showArrows": { "type": "boolean", "default": true },
		"paginationType": { "type": "string", "default": "bullets" },
		"arrowColor": { "type": "string", "default": "" },
		"bulletColor": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
